{
  "name": "wiz-rc",
  "displayName": "WiZ RC",
  "version": "0.1.3",
  "description": "Control remoto por WiFi (UDP, puerto 38899) para luces WiZ: busca las lámparas en la red y controla encendido, color, blanco, brillo y escenas.",
  "perms": [
    "wifi"
  ],
  "stack": 8192,
  "intents": {
    "light.on": {
      "title": "Encender las luces",
      "args": {
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.off": {
      "title": "Apagar las luces",
      "args": {
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.brightness": {
      "title": "Brillo",
      "args": {
        "level": "int:10-100",
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.color": {
      "title": "Color RGB",
      "args": {
        "r": "int:0-255",
        "g": "int:0-255",
        "b": "int:0-255",
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.temp": {
      "title": "Blanco (kelvin)",
      "args": {
        "kelvin": "int:2200-6500",
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.scene": {
      "title": "Escena",
      "args": {
        "name": "text:24",
        "id": "int:1-32",
        "ip": "text:15"
      },
      "returns": "ok",
      "timeout_ms": 15000
    },
    "light.find": {
      "title": "Buscar lámparas",
      "returns": "list:12",
      "timeout_ms": 15000
    }
  }
}
