{
  "name": "ble-sentinel",
  "displayName": "BLE Sentinel",
  "version": "0.11.3",
  "description": "Detector pasivo de dispositivos BLE: identifica drones (Remote ID), smart glasses, trackers y más por firma de manufacturer data. Solo escucha, nunca anuncia.",
  "perms": [
    "audio_out",
    "sd",
    "ble"
  ],
  "stack": 8192,
  "intents": {
    "sentinel.scan": {
      "title": "Escanear y contar por categoría",
      "args": {
        "seconds": "int:2-30"
      },
      "needs": [
        "ble"
      ],
      "returns": {
        "drone": "int",
        "glasses": "int",
        "tracker": "int",
        "headset": "int",
        "other": "int",
        "unknown": "int"
      },
      "timeout_ms": 40000
    },
    "sentinel.count": {
      "title": "Contar una categoría (drone, glasses, tracker, headset, other, unknown, any)",
      "args": {
        "category": "text:7",
        "seconds": "int:2-30"
      },
      "needs": [
        "ble"
      ],
      "returns": "int",
      "timeout_ms": 40000
    }
  }
}
