{
  "name": "led-rc",
  "displayName": "LED RC",
  "version": "0.1.3",
  "description": "Control remoto infrarrojo para luces LED RGB genéricas: mandos de 24 y 44 teclas (NEC), con grilla de colores, brillo, efectos y atajos.",
  "perms": [
    "ir"
  ],
  "stack": 8192,
  "intents": {
    "strip.on": {
      "title": "Encender la tira",
      "returns": "ok",
      "timeout_ms": 3000
    },
    "strip.off": {
      "title": "Apagar la tira",
      "returns": "ok",
      "timeout_ms": 3000
    },
    "strip.color": {
      "title": "Color RGB (el más parecido del mando)",
      "args": {
        "r": "int:0-255",
        "g": "int:0-255",
        "b": "int:0-255"
      },
      "returns": "text:20",
      "timeout_ms": 3000
    },
    "strip.brightness": {
      "title": "Brillo",
      "args": {
        "dir": "text:4",
        "steps": "int:1-10"
      },
      "returns": "ok",
      "timeout_ms": 4000
    },
    "strip.mode": {
      "title": "Modo (flash, strobe, fade, smooth)",
      "args": {
        "name": "text:6"
      },
      "returns": "ok",
      "timeout_ms": 3000
    }
  }
}
